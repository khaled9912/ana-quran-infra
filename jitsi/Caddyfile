# Ana Quran — Jitsi Meet edge proxy.
#
# Install on the VPS at /etc/caddy/Caddyfile, replace the hostname, then:
#   sudo systemctl reload caddy
#
# Caddy obtains and renews the Let's Encrypt certificate itself, redirects HTTP
# to HTTPS, and proxies WebSocket upgrades (BOSH + XMPP-over-WebSocket signalling)
# without extra configuration. Jitsi keeps serving plain HTTP on 127.0.0.1:8000,
# so set HTTP_PORT=127.0.0.1:8000 and HTTPS_PORT=127.0.0.1:8443 in .env.
meet.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
}
