# =============================================================================
# Jitsi Meet environment for Ana Quran lessons
#
# deploy.sh copies this to .env on first run and fills in CONFIG plus the
# generated passwords. .env is gitignored: never commit it.
# Full upstream reference: env.example.
# =============================================================================

# Where Jitsi stores config + runtime state. deploy.sh rewrites this to an
# absolute path (./config); if it is empty the compose mounts collapse to "/".
CONFIG=

# Compose project name, so containers are easy to identify.
COMPOSE_PROJECT_NAME=ana-quran-jitsi

# Container timezone (log timestamps only).
TZ=Africa/Cairo

# -----------------------------------------------------------------------------
# Public address
# -----------------------------------------------------------------------------
# Production: the bare domain, port 443 implied. The web app builds
# `https://${NEXT_PUBLIC_JITSI_DOMAIN}`, so a port here would leak into every
# room URL and the signalling endpoint.
# Local dev: https://localhost:8443
PUBLIC_URL=https://meet.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Both default to loopback: Caddy owns 443 on the VPS, and locally the browser
# only needs localhost. Nothing here should be reachable from the internet.
HTTP_PORT=127.0.0.1:8000
HTTPS_PORT=127.0.0.1:8443

# -----------------------------------------------------------------------------
# Media (JVB)
# -----------------------------------------------------------------------------
# Must be the VPS public IP so browsers send audio/video straight to it (behind
# 1:1 NAT this is the public IP). Local dev: 127.0.0.1 — deploy.sh refuses to
# start with a remote PUBLIC_URL and this still set to loopback.
JVB_ADVERTISE_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# TLS
# -----------------------------------------------------------------------------
# Keep 0: Caddy terminates TLS with Let's Encrypt. Set to 1 only if you drop
# Caddy and let the web container manage certificates (then also set
# LETSENCRYPT_DOMAIN and publish 80/443).
ENABLE_LETSENCRYPT=0

# -----------------------------------------------------------------------------
# Access
# -----------------------------------------------------------------------------
# No XMPP accounts: anyone holding a room link can join. The web app only shows
# the join button after the teacher arrives, but that is a UX gate, not a
# security boundary (see "Hardening" in the README).
ENABLE_AUTH=0
ENABLE_GUESTS=1

# -----------------------------------------------------------------------------
# Transport
# -----------------------------------------------------------------------------
# BOSH and XMPP-over-WebSocket signalling. Both must survive the reverse proxy.
ENABLE_XMPP_WEBSOCKET=1

# -----------------------------------------------------------------------------
# Component passwords — replaced by deploy.sh on first run.
# Only used between containers (prosody / jicofo / jvb / jigasi / jibri).
# -----------------------------------------------------------------------------
JICOFO_AUTH_PASSWORD=change-me
JVB_AUTH_PASSWORD=change-me
JIGASI_XMPP_PASSWORD=change-me
JIGASI_TRANSCRIBER_PASSWORD=change-me
JIBRI_RECORDER_PASSWORD=change-me
JIBRI_XMPP_PASSWORD=change-me
